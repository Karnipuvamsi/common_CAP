## `src/my/math/ArithmeticUtil.js`

```javascript
sap.ui.define([], function () {
  "use strict";

  /**
   * @namespace my.math.ArithmeticUtil
   * Arithmetic utility — Add, Subtract, Multiply, Divide
   */
  const ArithmeticUtil = {

    /**
     * Add two numbers.
     * @param {number} a
     * @param {number} b
     * @returns {number}
     */
    add: function (a, b) {
      this._validate(a, b);
      return a + b;
    },

    /**
     * Subtract b from a.
     * @param {number} a
     * @param {number} b
     * @returns {number}
     */
    subtract: function (a, b) {
      this._validate(a, b);
      return a - b;
    },

    /**
     * Multiply two numbers.
     * @param {number} a
     * @param {number} b
     * @returns {number}
     */
    multiply: function (a, b) {
      this._validate(a, b);
      return a * b;
    },

    /**
     * Divide a by b.
     * @param {number} a
     * @param {number} b
     * @returns {number}
     */
    divide: function (a, b) {
      this._validate(a, b);
      if (b === 0) {
        throw new Error("ArithmeticUtil: Division by zero is not allowed.");
      }
      return a / b;
    },

    /**
     * @private
     * Validates both inputs are finite numbers.
     */
    _validate: function (a, b) {
      if (typeof a !== "number" || typeof b !== "number") {
        throw new Error("ArithmeticUtil: Inputs must be numbers.");
      }
      if (!isFinite(a) || !isFinite(b)) {
        throw new Error("ArithmeticUtil: Inputs must be finite.");
      }
    }

  };

  return ArithmeticUtil;
});
```

