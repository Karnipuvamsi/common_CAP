## `webapp/controller/Main.controller.js`

```javascript
sap.ui.define([
  "sap/ui/core/mvc/Controller",
  "my/math/ArithmeticUtil",
  "sap/m/MessageToast"
], function (Controller, ArithmeticUtil, MessageToast) {
  "use strict";

  return Controller.extend("my.app.controller.Main", {

    onInit: function () {
      // Smoke test on load — visible in browser console
      console.log("=== ArithmeticUtil Smoke Test ===");
      console.log("add(5, 3)       =>", ArithmeticUtil.add(5, 3));        // 8
      console.log("subtract(10, 4) =>", ArithmeticUtil.subtract(10, 4)); // 6
      console.log("multiply(6, 7)  =>", ArithmeticUtil.multiply(6, 7));  // 42
      console.log("divide(20, 4)   =>", ArithmeticUtil.divide(20, 4));   // 5
    },

    onAdd: function () {
      this._calculate("add");
    },

    onSubtract: function () {
      this._calculate("subtract");
    },

    onMultiply: function () {
      this._calculate("multiply");
    },

    onDivide: function () {
      this._calculate("divide");
    },

    _calculate: function (operation) {
      const a = parseFloat(this.byId("inputA").getValue());
      const b = parseFloat(this.byId("inputB").getValue());

      // Guard: check for empty inputs
      if (isNaN(a) || isNaN(b)) {
        MessageToast.show("Please enter valid numbers in both fields.");
        return;
      }

      try {
        const result = ArithmeticUtil[operation](a, b);
        this.byId("resultText").setText(
          operation.toUpperCase() + "(" + a + ", " + b + ") = " + result
        );
      } catch (e) {
        MessageToast.show(e.message);
        this.byId("resultText").setText("Error: " + e.message);
      }
    }

  });
});
```

