6. mta.yaml  [NEW — Required for Deployment]
The mta.yaml file is the deployment descriptor. Without it, cf deploy cannot package the application correctly. The file below wires the CAP service, approuter, HDI container, and XSUAA instance together.



_schema-version: "3.1"
ID: age-role-app
version: 1.0.0


modules:


  - name: age-role-app-srv
    type: nodejs
    path: gen/srv
    parameters:
      buildpack: nodejs_buildpack
    build-parameters:
      builder: npm
    provides:
      - name: srv-api
        properties:
          srv-url: ${default-url}
    requires:
      - name: age-role-xsuaa
      - name: age-role-db


  - name: age-role-app-db-deployer
    type: hdb
    path: gen/db
    requires:
      - name: age-role-db


  - name: age-role-approuter
    type: approuter.nodejs
    path: app
    requires:
      - name: age-role-xsuaa
      - name: srv-api
        group: destinations
        properties:
          name: srv
          url: ~{srv-url}
          forwardAuthToken: true


resources:


  - name: age-role-xsuaa
    type: org.cloudfoundry.managed-service
    parameters:
      service: xsuaa
      service-plan: application
      path: ./xs-security.json


  - name: age-role-db
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared

