5.4  srv/service.cds  [FIXED — @requires added]
Added @requires annotation to enforce role-based access at the CDS layer in addition to the JS handler.


using demo from '../db/schema';


service PersonService {


  // FIXED: Require at least one of the two roles to read
  @requires: ['User1Role', 'User2Role']
  entity Persons as projection on demo.Persons;


  function getLoggedInUser() returns {
    id   : String;
    name : String;
  };


}

5.5  srv/service.js  [FIXED — safe filtering + null guards]
Key fixes: (1) if/else if/else pattern prevents data leakage when no role matches, (2) null-safe attribute access, (3) req.reject() for the no-role case.


const cds = require('@sap/cds');


module.exports = (srv) => {


  const { Persons } = srv.entities;


  // ── ROLE-BASED FILTERING ────────────────────────────
  srv.before('READ', Persons, (req) => {


    if (req.user.is('User1Role')) {
      // User1Role: sees only persons older than 40
      req.query.where({ age: { '>': 40 } });


    } else if (req.user.is('User2Role')) {
      // User2Role: sees only persons younger than 40
      req.query.where({ age: { '<': 40 } });


    } else {
      // No matching role: deny access explicitly
      req.reject(403, 'You do not have a role assigned to view this data.');
    }


  });


  // ── RETURN LOGGED-IN USER ──────────────────────────
  srv.on('getLoggedInUser', (req) => {


    const given  = req.user.attr?.givenName  ?? req.user.id;
    const family = req.user.attr?.familyName ?? '';


    return {
      id:   req.user.id,
      name: (given + ' ' + family).trim(),
    };


  });


};

