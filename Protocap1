7.2  app/fiori-app/webapp/controller/Main.controller.js  [FIXED]
Fixed: error handling on the fetch call; service path read from manifest; proper binding setup.


sap.ui.define([
  'sap/ui/core/mvc/Controller',
  'sap/ui/model/odata/v4/ODataModel',
  'sap/m/MessageToast'
], function (Controller, ODataModel, MessageToast) {
  'use strict';


  return Controller.extend("demo.controller.Main", {


    onInit: function () {
      // OData model is set up in manifest.json — just fetch the user
      this._loadLoggedInUser();
    },


    _loadLoggedInUser: function () {
      // FIXED: use relative path consistent with approuter routing
      fetch('/personservice/getLoggedInUser()')
        .then(function (res) {
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then(function (data) {
          const name = data.value?.name || data.name || "Unknown User";
          this.byId("userText").setText("Logged in as: " + name);
        }.bind(this))
        .catch(function (err) {
          this.byId("userText").setText("Could not load user info.");
          console.error("getLoggedInUser failed:", err);
        }.bind(this));
    }


  });


});

